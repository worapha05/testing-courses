{
  "name": "tooling-testing-bootcamp",
  "version": "1.0.0",
  "private": true,
  "description": "Zero to Expert bootcamp for Webpack, Vite, Jest, RTL, and Cypress",
  "type": "module",
  "scripts": {
    "test:beginner": "jest --config 01-beginner/examples/04-jest-unit-testing/jest.config.cjs",
    "test:intermediate": "jest --config 02-intermediate/jest.config.cjs",
    "test:lab:beginner": "jest --config 01-beginner/lab/solution/jest.config.cjs",
    "test:lab:intermediate": "jest --config 02-intermediate/lab/solution/jest.config.cjs",
    "build:webpack": "webpack --config 01-beginner/examples/02-webpack-basics/webpack.config.cjs",
    "dev:vite": "vite --config 01-beginner/examples/03-vite-basics/vite.config.ts",
    "build:vite": "vite build --config 01-beginner/examples/03-vite-basics/vite.config.ts",
    "cypress:open": "cypress open --config-file 03-expert/examples/01-cypress-e2e/cypress.config.ts",
    "cypress:run": "cypress run --config-file 03-expert/examples/01-cypress-e2e/cypress.config.ts",
    "test:coverage:expert": "jest --config 03-expert/examples/03-coverage-optimization/jest.coverage.config.cjs",
    "test:lab:expert-unit": "jest --config 03-expert/lab/solution/jest.coverage.config.cjs",
    "postinstall": "node -e \"console.log('Tip: run npx cypress install if you will use E2E labs')\"",
    "lint": "echo \"Add ESLint config in your real project — bootcamp focuses on test tooling\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.26.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.2.1",
    "css-loader": "^7.1.2",
    "cypress": "^13.16.0",
    "dotenv-webpack": "^8.1.0",
    "html-webpack-plugin": "^5.6.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "msw": "^1.3.5",
    "sass": "^1.81.0",
    "sass-loader": "^16.0.3",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1",
    "webpack": "^5.96.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0",
    "whatwg-fetch": "^3.6.20"
  }
}
